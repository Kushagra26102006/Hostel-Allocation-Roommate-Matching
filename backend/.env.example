# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/hostelhub
REDIS_URL=redis://localhost:6379

# Security & Tokens
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-length!!
JWT_REFRESH_SECRET=super-secret-refresh-jwt-key-32-chars-min!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
COOKIE_SECRET=super-secret-cookie-signing-key-32-chars!!

# OIDC SSO
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=hostelhub-client-id
OIDC_CLIENT_SECRET=hostelhub-client-secret
OIDC_REDIRECT_URI=http://localhost:4000/api/v1/auth/sso/callback

# Storage (S3 / MinIO / Local)
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=hostelhub-documents
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# Notification & Email
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@hostelhub.local
EMAIL_API_KEY=dummy-resend-api-key
SMS_PROVIDER=console
SMS_API_KEY=dummy-sms-api-key
TELEGRAM_BOT_TOKEN=dummy-bot-token

# VAPID Keys for Web Push
VAPID_PUBLIC_KEY=BH...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:admin@hostelhub.local

# AI Assistant
ASSISTANT_PROVIDER=disabled
GEMINI_API_KEY=

# Routing Service
ROUTING_PROVIDER=haversine
OPENROUTESERVICE_API_KEY=

# Observability
SENTRY_DSN=
LOG_LEVEL=info
