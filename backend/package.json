{
  "name": "@hostelhub/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --project tsconfig.json --outDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/reset.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "create-student": "tsx scripts/create-student.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@hostelhub/db": "workspace:*",
    "@hostelhub/domain": "workspace:*",
    "@hostelhub/shared": "workspace:*",
    "@sentry/node": "^10.75.1",
    "argon2": "^0.45.1",
    "bullmq": "^5.41.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "fast-json-stable-stringify": "^2.1.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
