{
  "name": "@hostelhub/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:pbt": "PBT_RUNS=2000 vitest run src/__tests__/allocation/property.test.ts",
    "test:pbt:ci": "CI=true vitest run src/__tests__/allocation/property.test.ts",
    "bench:allocation": "tsx ../../scripts/bench-allocation.ts",
    "build": "tsc --project tsconfig.json --outDir dist"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "papaparse": "^5.7.0"
  }
}
