# HostelHub Environment Variables
# Copy this file to .env and fill in the values.
# Safe defaults below match the docker-compose.yml services.

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"
APP_URL="http://localhost:3000"
PORT=3000

# ── Auth / Security ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET="changeme-auth-secret-32-chars-min"
MASTER_ENCRYPTION_KEY="changeme-master-key-32-chars-min"

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI="mongodb://localhost:27017/hostelhub?replicaSet=rs0&directConnection=true"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── MinIO (S3-compatible) ─────────────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="hostelhub"

# ── SMTP (Mailpit) ────────────────────────────────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT=1025

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Set to "true" to enable
FF_NEW_BOOKING_FLOW="false"
