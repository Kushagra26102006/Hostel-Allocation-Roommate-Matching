# HostelHub Environment Variables
# Copy this file to .env or apps/web/.env.local and fill in real secrets.
# Note: Next.js automatically loads environment variables from apps/web/.env.local during local development.

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"
APP_URL="http://localhost:3000"
PORT=3000
TRUST_HOST="false"

# ── Auth & Security ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET="changeme-auth-secret-32-chars-min"
MASTER_ENCRYPTION_KEY="changeme-master-key-32-chars-min"
ENCRYPTION_KEY_ID="key-v1"
AUTH_ALLOWED_DOMAIN="nit.edu"

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Turnstile (Captcha) ───────────────────────────────────────────────────────
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI="mongodb+srv://sy7666492_db_user:2nbj1EQSMoXkH7le@cluster0.qepsx5a.mongodb.net/"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── MinIO / S3 Storage ────────────────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="hostelhub"

# ── SMTP (Email) ──────────────────────────────────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@hostelhub.local"

# ── Malware Scanning ──────────────────────────────────────────────────────────
CLAMAV_HOST="localhost"
CLAMAV_PORT=3310

# ── AI Policy Assistant ───────────────────────────────────────────────────────
# Provider: "gemini" | "ollama" | "disabled" (auto-selects gemini if API key present)
ASSISTANT_PROVIDER="disabled"
# Google Gemini (free tier) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
# Ollama (local open model) — requires ollama daemon on OLLAMA_HOST
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3"

# ── Campus Map / Walking Distance ─────────────────────────────────────────────
# OpenRouteService (free tier) — https://openrouteservice.org/dev/#/signup
# Falls back to Haversine formula if not set
ORS_API_KEY=""
ORS_BASE_URL="https://api.openrouteservice.org"

# ── Feature Flags ─────────────────────────────────────────────────────────────
FF_NEW_BOOKING_FLOW="false"
